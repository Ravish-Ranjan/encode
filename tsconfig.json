{
	"compilerOptions": {
		"target": "es2024",
		"module": "nodenext",
		"types": [
			"node"
		],
		"outDir": "./dist",
		"rootDir": "./src",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src",
		"src/types.ts",
		"testing",
		"public"
	]
}